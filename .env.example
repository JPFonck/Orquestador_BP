# Credencial de Claude (no se necesita con LLM_PROVIDER=mock)
ANTHROPIC_API_KEY=

# anthropic = Claude real | mock = respuestas deterministas sin API key (demo/pruebas)
LLM_PROVIDER=anthropic
MODEL=claude-opus-5-5
SUBAGENT_EFFORT=low
DECISION_EFFORT=medium
ENABLE_FALLBACKS=true

MAX_AGENT_ITERATIONS=6
MAX_AGENT_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5

# memory | sqlite
STATE_BACKEND=memory
SQLITE_PATH=onboarding_state.db
